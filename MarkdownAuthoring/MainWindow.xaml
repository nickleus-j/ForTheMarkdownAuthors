<Window x:Class="MarkdownAuthoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" 
        xmlns:local="clr-namespace:MarkdownAuthoring"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Markdown Editor"
        Height="600"
        Width="1000"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Define colors as resources for consistency -->
        <SolidColorBrush x:Key="ToolbarBackground" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ContentBackground" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="StatusBarBackground" Color="#F0F0F0"/>

        <!-- Define button style -->
        <Style TargetType="Button" x:Key="ToolbarButtonStyle">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Define row heights -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBackground}"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Background="Bisque"
                       VerticalAlignment="Center"
                       Margin="8">
                <!-- Text Formatting Group -->
                <TextBlock Text="Text:" 
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          FontWeight="SemiBold"/>
                <Button Content="Bold" 
                       Click="Bold_Click"
                       Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Italic"
                       Click="Italic_Click"
                       Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Heading"
                       Click="Heading_Click"
                       Style="{StaticResource ToolbarButtonStyle}"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                          Margin="8,0"/>

                <!-- Insert Group -->
                <TextBlock Text="Insert:" 
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          FontWeight="SemiBold"/>
                <Button Content="Link"
                       Click="Link_Click"
                       Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Image"
                       Click="Image_Click"
                       Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="List"
                       Click="List_Click"
                       Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Blockquote"
                       Click="Blockquotes_Click"
                       Style="{StaticResource ToolbarButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1"
             Background="{StaticResource ContentBackground}"
             Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Editor -->
            <TabControl Grid.Column="0">
                <!-- Markdown Tab -->
                <TabItem Header="Markdown Content">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Text Editor -->
                        <Border Grid.Row="0"
                               BorderBrush="#CCCCCC"
                               BorderThickness="1"
                               Margin="8">
                            <TextBox Name="MarkdownTextBox"
                                    AcceptsReturn="True"
                                    TextChanged="MarkdownTextBox_TextChanged"
                                    Background="White"
                                    Foreground="Black"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Padding="8"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"/>
                        </Border>

                        <!-- Find/Replace Panel -->
                        <StackPanel Grid.Row="1"
                                   Background="#F9F9F9"
                                   Orientation="Vertical"
                                   Margin="8">
                            <TextBlock Text="Find &amp; Replace"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="Find:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                        Name="FindText"
                                        Margin="4,0,8,0"
                                        Padding="6,4"/>

                                <Label Grid.Column="2" Content="Replace:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="3"
                                        Name="ReplaceText"
                                        Margin="4,0,8,0"
                                        Padding="6,4"/>

                                <Button Grid.Column="4"
                                       Content="Replace All"
                                       Click="ReplaceButton_Click"
                                       Padding="12,4"
                                       Margin="4,0"/>

                                <TextBlock Grid.Column="5"
                                          Name="ReplaceStatus"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          Foreground="Green"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Styles Tab -->
                <TabItem Header="Styles">
                    <ScrollViewer Padding="12">
                        <StackPanel >
                            <!-- Font Selection -->
                            <StackPanel>
                                <TextBlock Text="Font"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,6"/>
                                <ComboBox Name="FontBox"
                                         SelectionChanged="FontBox_SelectionChanged"
                                         Padding="8,6"/>
                            </StackPanel>

                            <!-- Link Color -->
                            <local:ColorPicker x:Name="LinkColorPicker"
                                              Title="Link Color"
                                              ChangeColor="LinkColorPicker_ChangeColor"/>

                            <!-- Bullet Style -->
                            <local:ListStyle x:Name="DefaultBulletStyle"
                                            Title="Bullet Style"
                                            ChangeStyle="DefaultBulletStyle_ChangeStyle"/>

                            <!-- Heading Options -->
                            <StackPanel>
                                <TextBlock Text="Heading Options"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,6"/>
                                <CheckBox Name="UnderlineHeadings"
                                         Content="Underline Headings"
                                         Checked="UnderlineHeadings_Checked"
                                         Unchecked="UnderlineHeadings_Unchecked"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Blockquote Font Size -->
                            <StackPanel>
                                <TextBlock Text="Blockquote Font Size"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,6"/>
                                <ComboBox Name="BlockquoteFontSize"
                                         SelectedIndex="0"
                                         SelectionChanged="BlockquoteFontSize_SelectionChanged"
                                         Padding="8,6">
                                    <ComboBoxItem Content="100%"/>
                                    <ComboBoxItem Content="90%"/>
                                    <ComboBoxItem Content="110%"/>
                                    <ComboBoxItem Content="120%"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1"
                         Width="4"
                         HorizontalAlignment="Center"
                         Background="#E0E0E0"
                         ShowsPreview="True"/>

            <!-- RIGHT PANEL: Preview -->
            <Grid Grid.Column="2"
                 Background="White"
                 Margin="0,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                       Background="#F5F5F5"
                       BorderBrush="#E0E0E0"
                       BorderThickness="0,0,0,1"
                       Padding="8">
                    <TextBlock Name="PreviewLabel"
                              Text="Preview"
                              FontWeight="SemiBold"
                              FontSize="13"/>
                </Border>

                <Border Grid.Row="1"
                       BorderBrush="#CCCCCC"
                       BorderThickness="1"
                       Margin="8">
                    <WebBrowser Name="PreviewBrowser"
                               Margin="0"/>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
               Background="{StaticResource StatusBarBackground}"
               BorderBrush="#E0E0E0"
               BorderThickness="0,1,0,0">
            <ui:SimpleStackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                >
                <!-- File Status -->
                <TextBlock Name="FileStatusLabel"
                          Foreground="#555555"/>

                <!-- File Operations -->
                <Button Content="Open File"
                       Click="OpenTextButton_Click"
                       Padding="10,4"
                       FontSize="11"/>
                <Button Content="Save File"
                       Click="SaveTextButton_Click"
                       Padding="10,4"
                       FontSize="11"/>

                <!-- Spacer -->
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                          Margin="0"/>

                <!-- Export Options -->
                <TextBlock Text="Export:"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"/>

                <ComboBox Name="PageSizeSelector"
                         Width="120"
                         Padding="8,4"
                         FontSize="11"/>

                <Button Content="Save as PDF"
                       Click="SaveAsPdfButton_Click"
                       Padding="10,4"
                       FontSize="11"/>

                <Button Content="Save as ODT"
                       Click="SaveAsOdtButton_Click"
                       Padding="10,4"
                       FontSize="11"/>

                <!-- Export Status -->
                <TextBlock Name="ExportStatusLabel"
                          Foreground="#555555"
                          Margin="8,0,0,0"/>
            </ui:SimpleStackPanel>
        </Border>
    </Grid>
</Window>
